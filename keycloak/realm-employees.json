{
  "realm": "employees",
  "enabled": true,
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "clients": [
    {
      "clientId": "talentflow-onboarding",
      "secret": "dev-onboarding-client-secret",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "roles",
        "service_account",
        "kc-admin-api"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "admin-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "realm-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-talentflow-onboarding",
      "enabled": true,
      "serviceAccountClientId": "talentflow-onboarding",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"onboarding_saga_id\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"talentflow_tenant_id\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}]}"
          ]
        }
      }
    ]
  },
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "talentflow-onboarding",
        "roles": [
          "manage-users"
        ]
      }
    ]
  }
}
