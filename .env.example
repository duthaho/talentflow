CORS_ALLOWED_ORIGINS=http://localhost:3000
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_JWKS_CACHE_TTL_SECONDS=300
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=
