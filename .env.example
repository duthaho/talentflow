# Local development only. Do not reuse any value in this file outside a local compose stack.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin-password
DEMO_USER_PASSWORD=dev-demo-password
APP_ENV=development
AUTH_MODE=oidc_jwt
DATABASE_URL=postgresql+psycopg://talentflow:talentflow@postgres:5432/talentflow
# Comma-separated trusted browser origins. Production requires explicit HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
OIDC_ISSUER=http://localhost:8081/realms/talentflow
OIDC_AUDIENCE=talentflow-api
OIDC_JWKS_URL=http://keycloak:8080/realms/talentflow/protocol/openid-connect/certs
OIDC_JWKS_CACHE_TTL_SECONDS=300
NOTIFICATION_EMAIL_ADAPTER=smtp
NOTIFICATION_SMTP_HOST=mailpit
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_FROM_EMAIL=notifications@talentflow.local
# Required only when NOTIFICATION_EMAIL_ADAPTER=sendgrid.
SENDGRID_API_KEY=
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
ATTACHMENT_STORAGE_ROOT=./data/attachments
ATTACHMENT_STORAGE_BACKEND=filesystem
ATTACHMENT_S3_ENDPOINT_URL=
ATTACHMENT_S3_PUBLIC_ENDPOINT_URL=
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
ATTACHMENT_S3_BUCKET=talentflow-attachments
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_DOWNLOAD_TTL_SECONDS=300
# Required by the Compose-local SeaweedFS service; set locally, never commit values.
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_BOOTSTRAP_ACCESS_KEY=
SEAWEEDFS_BOOTSTRAP_SECRET_KEY=
ATTACHMENT_MAX_BYTES=5242880
# Production requires clamav scanning and an absolute private storage root.
ATTACHMENT_SCAN_MODE=noop
ATTACHMENT_SCAN_COMMAND=clamscan
ATTACHMENT_CLAMAV_HOST=
ATTACHMENT_CLAMAV_PORT=3310
CALENDAR_SUBSCRIPTION_LIFETIME_DAYS=90
CALENDAR_INTERVIEW_DURATION_MINUTES=60
# Required in production; must be an HTTPS canonical public API URL.
CALENDAR_PUBLIC_BASE_URL=http://localhost:8000
RETENTION_WORKER_BATCH_SIZE=100
# Leave blank outside Docker Compose to keep OTLP export disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_INSECURE=true  # unset = derive from endpoint scheme
OTEL_SERVICE_NAME=talentflow-api
OTEL_SEMCONV_STABILITY_OPT_IN=http
OTEL_METRIC_EXPORT_INTERVAL=5000
GRAFANA_PORT=3001
