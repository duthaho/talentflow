APP_ENV=development
AUTH_MODE=development_headers
DATABASE_URL=postgresql+psycopg://talentflow:talentflow@postgres:5432/talentflow
# Comma-separated trusted browser origins. Production requires explicit HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_JWKS_CACHE_TTL_SECONDS=300
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
ATTACHMENT_STORAGE_ROOT=./data/attachments
ATTACHMENT_MAX_BYTES=5242880
# Production requires clamav scanning and an absolute private storage root.
ATTACHMENT_SCAN_MODE=noop
ATTACHMENT_SCAN_COMMAND=clamscan
